{
  "name": "penpot-to-flutter",
  "private": true,
  "version": "0.0.45",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint .",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js"
  },
  "dependencies": {
    "@penpot/plugin-types": "1.5.0",
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.0.5",
    "vite-live-preview": "^0.3.2"
  }
}
